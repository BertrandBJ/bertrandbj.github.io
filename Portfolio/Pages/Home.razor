@page "/"

<PageTitle>Bertrand Beaujard – Développeur full stack C# / .NET</PageTitle>

<h1>Bertrand Beaujard</h1>

<section id="projets">
    <h2>Projets</h2>

    @if (_projects is null)
    {
        <p>Chargement…</p>
    }
    else
    {
        <div class="project-grid">
            @foreach (var project in _projects)
            {
                <ProjectCard @key="project.Slug" Project="@project" />
            }
        </div>
    }
</section>