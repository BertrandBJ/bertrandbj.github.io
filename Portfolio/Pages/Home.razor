@page "/"

<PageTitle>Bertrand Beaujard – Développeur C# / .NET</PageTitle>

<h1>Bertrand Beaujard</h1>

@if (_projects is null)
{
    <p>Chargement…</p>
}
else
{
    <ul>
        @foreach (var project in _projects)
        {
            <li>@project.Title — @project.Status</li>
        }
    </ul>
}