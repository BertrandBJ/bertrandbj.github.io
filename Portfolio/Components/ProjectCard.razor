<article class="project-card reveal">
    
    @if (CoverImage is not null)
    {
        <img class="project-card-image" 
             src="@CoverImage.Path"
             alt="@CoverImage.Alt" 
             loading="lazy" />
    }
    else
    {
        <div class="project-card-placeholder" 
             aria-hidden="true">
            <span>@Project.Slug</span>
        </div>
    }
    
    <div class="project-card-body">

        <h3 class="project-card-title">
            @Project.Title
            
            @if (ShowStatus)
            {
                <span class="project-status @StatusCssClass">@Project.Status.ToLabel()</span>
            }
        </h3>

        <p>@Project.ShortDescription</p>

        <ul class="project-card-techs">
            @foreach (var tech in Project.Technologies)
            {
                <li><TechBadge Name="@tech"/></li>
            }
        </ul>

        <p class="project-card-meta">@MetaLine</p>

        <a class="project-card-link"
           href="@DetailUrl">Voir le projet</a>
        
    </div>
    <!--Affichage des projets avec description + ajout des TechBadge dedans, va service pour l'overview des diff projet que j'ai fait. p-e delete le status -->
</article>

