<article class="project-card">
    
    @if (HasImage)
    {
        <img class="project-card-image" 
             src="@Project.ImagePath" 
             alt="@Project.ImageAlt" 
             loading="lazy"/>
    }

    <div class="project-card-body">

        <h3 class="project-card-title">
            @Project.Title
            
            @if (ShowStatus)
            {
                <span class="project-status"> @Project.Status.ToLabel()</span>
            }
        </h3>

        <p>@Project.ShortDescription</p>

        <ul class="project-card-techs">
            @foreach (var tech in Project.Technologies)
            {
                <li><TechBadge Name="@tech"/></li>
            }
        </ul>

        <p class="project-card-meta">@MetaLine</p>
        
        <a class="project-card-link" 
           href="@DetailUrl">Voir le projet</a>
        
    </div>
    <!--Affichage des projets avec description + ajout des TechDadge dedans, va service pour l'overview des diff projet que j'ai fait. p-e delete le status -->
</article>

