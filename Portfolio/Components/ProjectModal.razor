<div class="project-modal-backdrop" @onclick="RequestClose">
    
    <div class="project-modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="modal-title"
         tabindex="-1"
         @ref="_dialog"
         @onclick:stopPropagation="true"
         @onkeydown="HandleKeyDown">

        <button class="project-modal-close"
                type="button"
                aria-label="Fermer"
                @onclick="RequestClose">×</button>

        <header>
            <p class="project-meta">@MetaLine</p>
            <h2 id="modal-title">
                @Project.Title
                @if (ShowStatus)
                {
                    <span class="project-status @StatusCssClass">@Project.Status.ToLabel()</span>
                }
            </h2>
            <p class="project-lead">@Project.ShortDescription</p>
        </header>

        @if (CurrentImage is not null)
        {
            <div class="project-modal-gallery">
                <img class="gallery-image" 
                     src="@CurrentImage.Path" 
                     alt="@CurrentImage.Alt" />

                @if (HasMultipleImages)
                {
                    <button type="button" 
                            class="gallery-button gallery-button--prev"
                            aria-label="Image précédente" 
                            @onclick="ShowPreviousImage">‹</button>
                    
                    <button type="button" 
                            class="gallery-button gallery-button--next"
                            aria-label="Image suivante"
                            @onclick="ShowNextImage">›</button>
                }
            </div>

            @if (HasMultipleImages)
            {
                <div class="gallery-dots">
                    @for (int i = 0; i < _galleryImages.Count; i++)
                    {
                        int index = i;
                        <button type="button" 
                                class="@DotCssClass(index)"
                                aria-label="Afficher l'image @(index + 1)"
                                @onclick="() => ShowImage(index)"></button>
                    }
                    <span class="gallery-counter">@(_currentImageIndex + 1) / @_galleryImages.Count</span>
                </div>
            }
        }

        @foreach (var projectSection in Project.Sections)
        {
            <section @key="projectSection.Title">
                <h3>@projectSection.Title</h3>

                @if (!string.IsNullOrWhiteSpace(projectSection.Text))
                {
                    <p>@projectSection.Text</p>
                }

                @if (projectSection.Items.Count > 0)
                {
                    <ul>
                        @foreach (var item in projectSection.Items)
                        {
                            <li>@item</li>
                        }
                    </ul>
                }
            </section>
        }

        <section>
            <h3>Technologies</h3>
            <ul class="project-techs">
                @foreach (var tech in Project.Technologies)
                {
                    <li><TechBadge Name="@tech"/></li>
                }
            </ul>
        </section>

        @if (Project.RepoUrl is not null)
        {
            <a class="button button-primary"
               href="@Project.RepoUrl"
               target="_blank" rel="noopener">Voir le code</a>
        }
        @if (Project.LiveUrl is not null)
        {
            <a class="button button-secondary"
               href="@Project.LiveUrl"
               target="_blank"
               rel="noopener">Voir le site</a>
        }

    </div>
</div>